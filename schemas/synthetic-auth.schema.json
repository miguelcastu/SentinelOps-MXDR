{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic authentication source event v1.0",
  "type": "object",
  "required": [
    "batch_id",
    "event_code",
    "event_id",
    "hostname",
    "schema_version",
    "source",
    "source_ip",
    "synthetic",
    "timestamp",
    "username"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "source": {
      "const": "sentinelops-synthetic-auth"
    },
    "event_code": {
      "type": "integer",
      "enum": [
        4624,
        4625
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "source_ip": {
      "type": "string",
      "maxLength": 45
    },
    "event_id": {
      "type": "string",
      "pattern": "^synthetic-[0-9a-f]{32}$"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^synthetic-[0-9a-f]{32}$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^lab-auth-[0-9]{2}$"
    },
    "username": {
      "type": "string",
      "pattern": "^synthetic-user-[0-9]{2}$"
    }
  }
}
